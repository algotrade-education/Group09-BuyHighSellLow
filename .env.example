# ============================================================================
# BuyHigh-SellLow Environment Template
# Copy this file to .env and adjust values for your machine/account.
# ============================================================================

# ----------------------------------------------------------------------------
# Core DB (used by config/config.py and related data services)
# ----------------------------------------------------------------------------
# PostgreSQL host
DB_HOST=localhost
# PostgreSQL port
DB_PORT=5432
# Database name
DB_NAME=vn30_futures
# Database user
DB_USER=postgres
# Database password
DB_PASSWORD=secret

# ----------------------------------------------------------------------------
# Paper trading broker/FIX connection (src/run_paper_trade.py, src/paper/*)
# ----------------------------------------------------------------------------
# Paper broker login username
PAPER_USERNAME=BL01
# Paper broker login password
PAPER_PASSWORD=123
# Paper broker REST API base URL
PAPER_REST_BASE_URL=http://localhost:9090
# Default paper sub-account ID
PAPER_ACCOUNT_ID_D1=D1

# FIX host (broker gateway)
SOCKET_CONNECT_HOST=localhost
# FIX port
SOCKET_CONNECT_PORT=5001
# FIX sender comp id (client id)
SENDER_COMP_ID=cross-FIX
# FIX target comp id (server id)
TARGET_COMP_ID=SERVER

# ----------------------------------------------------------------------------
# Market data Redis for live paper trading (src/paper_trade/bootstrap.py)
# Not required in --sim mode (historical replay).
# ----------------------------------------------------------------------------
# Market Redis host
MARKET_REDIS_HOST=localhost
# Market Redis port
MARKET_REDIS_PORT=6379
# Market Redis password (blank if not set)
MARKET_REDIS_PASSWORD=

# ----------------------------------------------------------------------------
# Paper runtime toggles (config/runtime_config.py -> get_paper_runtime_config)
# Accepts: 1/true/yes/on for true; otherwise false.
# ----------------------------------------------------------------------------
# Enable fallback closed-bar fetch from DB when live ticks are missing
PAPER_ENABLE_DB_BAR_FALLBACK=true
# Close open position when bot stops/shuts down (recommended false for debugging)
PAPER_CLOSE_ON_SHUTDOWN=false
# Force hard process exit after shutdown cleanup (workaround for FIX teardown issues)
PAPER_FORCE_HARD_EXIT=false
# Block new entries this many seconds before session end
PAPER_ENTRY_CUTOFF_SECONDS=60
# Allow entries near session boundary (overrides cutoff)
PAPER_ALLOW_LATE_ENTRY=false
# Force flat when crossing out of trading session in bar loop
PAPER_FORCE_FLAT_ON_SESSION_CLOSE=true
# Force flat this many seconds before VN30 sub-session end (0=disabled).
# If SESSION_CLOSE=true and this=0 and LAST_CANDLE=false, engine auto-fallbacks to 15s.
PAPER_FORCE_FLAT_PRECLOSE_SECONDS=0
# Force flat on the final bar of each VN30 sub-session window
PAPER_FORCE_FLAT_ON_LAST_CANDLE=false
# If an exit trigger occurs outside session, defer until next tradable bar
PAPER_DEFER_EXIT_OUTSIDE_SESSION=false

# ----------------------------------------------------------------------------
# Paper bar-construction runtime (config/runtime_config.py -> get_paper_bar_runtime_config)
# ----------------------------------------------------------------------------
# Tick staleness threshold (seconds) for bar builder
PAPER_BAR_STALE_SECONDS=5
# Seconds before bar close to attempt DB preclose fallback fetch
PAPER_BAR_PRECLOSE_FETCH_SECONDS=30
# Minimum live updates required before bar is considered sufficiently formed
PAPER_BAR_MIN_UPDATES=2
# Verbose quote-level logging for bar builder
PAPER_DEBUG_QUOTES=false

# ----------------------------------------------------------------------------
# Backtest runtime toggles (config/runtime_config.py -> get_backtest_runtime_config)
# ----------------------------------------------------------------------------
# Block new entries this many seconds before session end in backtests
BACKTEST_ENTRY_CUTOFF_SECONDS=0
# Allow late entries near session close in backtests
BACKTEST_ALLOW_LATE_ENTRY=false

# ----------------------------------------------------------------------------
# Logging controls
# ----------------------------------------------------------------------------
# Capture all loggers in unified setup (src/utils/logger.py)
LOG_CAPTURE_ALL=0

# ----------------------------------------------------------------------------
# paper_trading_tool module: Database (paper_trading_tool/config.py)
# These can reuse DB_* values above or be set differently for that tool.
# ----------------------------------------------------------------------------
# paper_trading_tool DB connection pool size
DB_POOL_SIZE=10

# ----------------------------------------------------------------------------
# paper_trading_tool module: Redis (paper_trading_tool/config.py)
# Different from MARKET_REDIS_* (core paper feed).
# ----------------------------------------------------------------------------
# Generic Redis host for paper_trading_tool services
REDIS_HOST=localhost
# Generic Redis port
REDIS_PORT=6379
# Generic Redis password
REDIS_PASSWORD=
# Generic Redis DB number/index
REDIS_DB=0
# Generic Redis connect timeout (seconds)
REDIS_TIMEOUT=5

# ----------------------------------------------------------------------------
# paper_trading_tool module: Broker API (paper_trading_tool/config.py)
# ----------------------------------------------------------------------------
# Broker API URL used by tool-level integrations
BROKER_API_URL=https://api.paperbroker.com
# Broker API key
BROKER_API_KEY=
# Broker API secret key
BROKER_SECRET_KEY=
# Broker API timeout (seconds)
BROKER_TIMEOUT=30
# Broker API max retries
BROKER_MAX_RETRIES=3

# ----------------------------------------------------------------------------
# paper_trading_tool module: Logging (paper_trading_tool/config.py)
# ----------------------------------------------------------------------------
# Log level (DEBUG/INFO/WARNING/ERROR)
LOG_LEVEL=INFO
# Python logging format string
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s
# Optional log file path (blank = stdout only)
LOG_FILE_PATH=
# Max log file size in bytes before rotation
LOG_MAX_FILE_SIZE=10485760
# Number of rotated backup files
LOG_BACKUP_COUNT=5

# ----------------------------------------------------------------------------
# paper_trading_tool module: UI/CLI (paper_trading_tool/config.py)
# ----------------------------------------------------------------------------
# Enable GUI mode in paper_trading_tool
ENABLE_GUI=false
# CLI prompt string
CLI_PROMPT=trading>
# Screen/data refresh interval (seconds)
REFRESH_INTERVAL=5
# Maximum rows shown in tables/views
MAX_DISPLAY_ROWS=50

# ----------------------------------------------------------------------------
# paper_trading_tool module: Retry policy (paper_trading_tool/config.py)
# ----------------------------------------------------------------------------
# Retry max attempts
RETRY_MAX_ATTEMPTS=3
# Exponential backoff factor
RETRY_BACKOFF_FACTOR=2.0
# Max retry delay (seconds)
RETRY_MAX_DELAY=30.0