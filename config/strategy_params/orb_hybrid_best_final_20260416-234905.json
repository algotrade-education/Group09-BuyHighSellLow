{
  "name": "Opening Range Breakout (ORB) Strategy",
  "version": "2.0.0",
  "strategy": {
    "resample_freq": "15min",
    "orb_minutes": 45,
    "atr_period": 17,
    "atr_tp_multiplier": 1.4000000000000001,
    "atr_sl_multiplier": 0.6000000000000001,
    "breakout_buffer": 0.4,
    "use_range_sl": false,
    "min_range_atr": 0.9,
    "max_range_atr": 2.7,
    "long_only": false,
    "use_volume_filter": false,
    "volume_filter_threshold": 0.5,
    "volume_ma_period": 20,
    "use_adx_filter": false,
    "adx_period": 14,
    "adx_min": 19.0,
    "require_close_confirmation": true,
    "max_trades_per_session": 1,
    "use_adaptive_volatility": true,
    "atr_lookback_period": 15,
    "volatility_low_threshold": 0.6,
    "volatility_high_threshold": 1.2,
    "low_vol_range_multiplier": 0.5,
    "high_vol_range_multiplier": 1.4,
    "low_vol_buffer_multiplier": 0.5,
    "high_vol_buffer_multiplier": 1.4
  },
  "risk": {
    "min_position_size": 1,
    "max_position_size": 10,
    "risk_per_trade_pct": 3.0,
    "max_daily_loss": 2.0,
    "use_trailing_stop": false,
    "trailing_atr_multiplier": 2.75,
    "entry_cutoff_seconds": 300,
    "allow_late_entry": false,
    "force_flat_on_session_close": true,
    "defer_exit_outside_session": true,
    "entry_ord_type": "LIMIT"
  }
}
