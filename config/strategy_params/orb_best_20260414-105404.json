{
  "name": "Opening Range Breakout (ORB) Strategy",
  "version": "2.0.0",
  "strategy": {
    "resample_freq": "15min",
    "orb_minutes": 35,
    "atr_period": 16,
    "atr_tp_multiplier": 2.8,
    "atr_sl_multiplier": 1.7000000000000002,
    "breakout_buffer": 0.35000000000000003,
    "use_range_sl": false,
    "min_range_atr": 1.2,
    "max_range_atr": 4.7,
    "long_only": false,
    "use_volume_filter": false,
    "volume_filter_threshold": 0.5,
    "volume_ma_period": 20,
    "use_adx_filter": false,
    "adx_period": 14,
    "adx_min": 20.0,
    "require_close_confirmation": false,
    "max_trades_per_session": 2
  },
  "risk": {
    "min_position_size": 1,
    "max_position_size": 10,
    "risk_per_trade_pct": 1.0,
    "max_daily_loss": 0.02,
    "use_trailing_stop": true,
    "trailing_atr_multiplier": 2.5,
    "entry_cutoff_seconds": 300,
    "allow_late_entry": false,
    "force_flat_on_session_close": true,
    "defer_exit_outside_session": true,
    "entry_ord_type": "LIMIT"
  }
}
