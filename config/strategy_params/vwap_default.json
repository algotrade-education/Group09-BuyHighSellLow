{
  "name": "VWAP Band Reversion Strategy",
  "version": "1.0.0",
  "strategy": {
    "resample_freq": "5min",
    "entry_band": 2.0,
    "atr_period": 14,
    "atr_sl_mult": 1.5,
    "min_tp_atr": 0.5,
    "cooldown_bars": 2,
    "session_warmup": 10,
    "long_only": false,
    "use_slope_filter": false,
    "slope_period": 5,
    "use_volume_filter": false,
    "vol_mult": 1.5,
    "vol_ma_period": 20
  },
  "risk": {
    "min_position_size": 1,
    "max_position_size": 1,
    "risk_per_trade_pct": 1.0,
    "max_daily_loss": 0.02,
    "use_trailing_stop": false,
    "trailing_atr_multiplier": 2.0,
    "entry_cutoff_seconds": 60,
    "allow_late_entry": false,
    "force_flat_on_session_close": false,
    "defer_exit_outside_session": true
  }
}
